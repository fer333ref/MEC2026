<!DOCTYPE html>
<html>

<body>
    <input id="email" type="email" placeholder="Email">
    <input id="password" type="password" placeholder="Password">
    <button id="signUp">Sign up</button>
    <button id="signIn">Sign in</button>
    <button id="signOut">Sign out</button>
    <p id="status"></p>

    <script type="module">

        //Firebase stuff
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
        import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut, onAuthStateChanged }
            from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

        import { getFirestore, doc, setDoc, getDoc }
            from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCx7AyRXmxz8Lp0w-c4Be-Z7NH6_2sg9oQ",
            authDomain: "mec-2026.firebaseapp.com",
            projectId: "mec-2026",
            storageBucket: "mec-2026.firebasestorage.app",
            messagingSenderId: "753030222688",
            appId: "1:753030222688:web:a0d3f396d04d294632c405",
            measurementId: "G-PGNC7J7TDQ"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);



        // end o firbase stuff

        //html elements refrences and events
        const email = document.getElementById("email");
        const password = document.getElementById("password");
        const status = document.getElementById("status");

        document.getElementById("signUp").onclick = () =>
            createUserWithEmailAndPassword(auth, email.value, password.value).catch(e => status.textContent = e.message);

        document.getElementById("signIn").onclick = () =>
            signInWithEmailAndPassword(auth, email.value, password.value).catch(e => status.textContent = e.message);

        document.getElementById("signOut").onclick = () => signOut(auth);

        onAuthStateChanged(auth, user => {
            status.textContent = user ? "Signed in as " + user.email : "Signed out";
        });
        window.save = async (data) => {
            await setDoc(doc(db, "users", auth.currentUser.uid), data);
            console.log("Saved:", data);
        };

        window.load = async () => {
            const snap = await getDoc(doc(db, "users", auth.currentUser.uid));
            console.log("Loaded:", snap.exists() ? snap.data() : "(nothing saved yet)");
        };
    </script>
</body>

</html>